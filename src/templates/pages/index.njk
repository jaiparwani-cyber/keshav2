{% extends "layout.njk" %}

{% block content %}
  <section class="hero-section text-white d-flex align-items-center" style="min-height:60vh;">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-6">
          <h1 class="display-4 fw-bold">Smart Dining for IISc Students</h1>
          <p class="lead mb-4">Real-time menus, QR payments, nutrition tracking, and instant feedback &mdash; all in one place.</p>
          <div class="d-flex gap-2">
            <a href="menu.html" class="btn btn-light btn-lg">View Menu</a>
            <button class="btn btn-outline-light btn-lg" data-bs-toggle="modal" data-bs-target="#feedbackModal">Give Feedback</button>
          </div>
        </div>
        <div class="col-lg-6 mt-4 mt-lg-0">
          <div class="card rounded-4 shadow-lg border-0 h-100">
            <div class="card-body d-flex flex-column justify-content-center p-5">
              <span class="badge bg-primary mb-3 align-self-start">Campus Fresh</span>
              <h3 class="fw-bold">Meals that feel fast, familiar, and fun.</h3>
              <p class="text-muted mb-4">A responsive mess UI built for every student device, with polished spacing and modern Bootstrap styling.</p>
              <a href="menu.html" class="btn btn-primary">Browse Today&rsquo;s Menu</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-5">
    <div class="container">
      <div class="text-center mb-4">
        <h2 class="fw-bold">Platform Features</h2>
        <p class="text-muted">Built for convenience, speed and nutrition awareness.</p>
      </div>

      <div class="row g-4">
        {% for feature in [
          { title: "Live Menu", body: "Daily items and allergen notes." },
          { title: "QR Payments", body: "Fast cashless transactions." },
          { title: "Nutrition Tracking", body: "Calories & macro breakdown." },
          { title: "Student Feedback", body: "Instant reports and analytics." }
        ] %}
          <div class="col-md-6 col-lg-3">
            <div class="card h-100 shadow-sm border-0 p-4 text-center">
              <h5 class="fw-bold">{{ feature.title }}</h5>
              <p class="mb-0 text-muted">{{ feature.body }}</p>
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="py-5 bg-light">
    <div class="container">
      <div class="text-center mb-4">
        <h2 class="fw-bold">Student Testimonials</h2>
      </div>

      <div id="testimonialCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-inner">
          <div class="carousel-item active">
            <div class="card mx-auto testimonial-card p-4 shadow-sm border-0">
              <p class="lead mb-0">&ldquo;The QR payments cut down our lunch queue by half.&rdquo;</p>
              <small class="d-block mt-3">&mdash; IISc Student</small>
            </div>
          </div>
          <div class="carousel-item">
            <div class="card mx-auto testimonial-card p-4 shadow-sm border-0">
              <p class="lead mb-0">&ldquo;Nutrition tracking helped me plan my research-day meals.&rdquo;</p>
              <small class="d-block mt-3">&mdash; Research Scholar</small>
            </div>
          </div>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="prev">
          <span class="carousel-control-prev-icon"></span>
          <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#testimonialCarousel" data-bs-slide="next">
          <span class="carousel-control-next-icon"></span>
          <span class="visually-hidden">Next</span>
        </button>
      </div>
    </div>
  </section>
{% endblock %}

{% block modal %}
<div class="modal fade" id="feedbackModal" tabindex="-1" aria-labelledby="feedbackModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="feedbackModalLabel">Give Feedback</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form id="modalFeedbackForm">
          <div class="mb-3">
            <label for="fb-name" class="form-label">Name</label>
            <input id="fb-name" class="form-control" required>
          </div>
          <div class="mb-3">
            <label for="fb-message" class="form-label">Message</label>
            <textarea id="fb-message" class="form-control" rows="4" required></textarea>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-primary" id="modalSubmitBtn">Submit</button>
      </div>
    </div>
  </div>
</div>
{% endblock %}
